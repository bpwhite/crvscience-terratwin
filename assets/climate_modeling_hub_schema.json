{
  "application": {
    "id": "planetary-climate-telemetry-hub",
    "name": "TerraTwin HPC Climate Modeling & Telemetry Hub",
    "version": "2.5.0",
    "architecture": "Zero-Dependency WebGPU/WebGL2 + Cloud-Optimized Zarr/PMTiles Streaming Engine",
    "computeBackend": {
      "ingestionEngine": "HPC Real-Time Level-1/2 Swath Assimilation & Downscaling",
      "tileServer": "Dynamic Zarr v3 Voxel Slicer + Vector PMTiles + COG (Cloud-Optimized GeoTIFF)",
      "reprojection": "On-the-fly GPU Compute Shader (WGS84 / EPSG:4326, Web Mercator / EPSG:3857, Polar Stereographic / EPSG:3995 & EPSG:3031)"
    }
  },
  "mainViewport": {
    "type": "global_map_canvas",
    "defaultProjection": "globe_3d_wgs84",
    "supportedProjections": [
      {
        "id": "globe_3d_wgs84",
        "label": "3D Planetary Globe (WGS84)",
        "epsg": "EPSG:4978"
      },
      {
        "id": "equirectangular_2d",
        "label": "2D Equirectangular Plate Carree",
        "epsg": "EPSG:4326"
      },
      {
        "id": "arctic_polar_stereo",
        "label": "Arctic Polar Stereographic",
        "epsg": "EPSG:3995"
      },
      {
        "id": "antarctic_polar_stereo",
        "label": "Antarctic Polar Stereographic",
        "epsg": "EPSG:3031"
      }
    ],
    "cameraDefaults": {
      "longitude": -20.0,
      "latitude": 20.0,
      "altitudeMeters": 14500000,
      "pitchDegrees": 0,
      "bearingDegrees": 0,
      "verticalExaggeration": 15.0
    },
    "verticalSliceEngine": {
      "enabled": true,
      "atmosphericLevelsHpa": [
        1000,
        925,
        850,
        700,
        500,
        300,
        250,
        100,
        50,
        10
      ],
      "oceanDepthLevelsMeters": [
        0,
        10,
        50,
        100,
        250,
        500,
        1000,
        2000,
        4000,
        6000
      ],
      "crossSectionTransectTool": true
    },
    "baseMaps": [
      {
        "id": "bathymetry_topography_shaded",
        "name": "GEBCO Bathymetry & FABDEM Terrain Relief",
        "source": "GEBCO 2025 + Copernicus DEM + NOAA Coastal LiDAR",
        "format": "pmtiles_raster_dem",
        "default": true
      },
      {
        "id": "dark_telemetry_vector",
        "name": "Dark Scientific Telemetry Basemap",
        "source": "OpenStreetMap + Natural Earth v5",
        "format": "pmtiles_vector",
        "default": false
      },
      {
        "id": "viirs_nightlights_baseline",
        "name": "VIIRS Black Marble Nighttime Lights",
        "source": "NASA Suomi NPP / NOAA-20 VIIRS DNB",
        "format": "cog_tiles",
        "default": false
      }
    ]
  },
  "uiLayout": {
    "topBar": {
      "components": [
        "global_anomaly_ticker",
        "projection_switcher",
        "ssp_scenario_selector",
        "coordinate_search_geocoder",
        "point_inspector_crosshair_toggle"
      ],
      "liveReadouts": [
        {
          "id": "global_2m_temp_anomaly",
          "label": "Global 2m Temp Anomaly (vs 1850-1900)",
          "unit": "degC",
          "source": "ECMWF ERA5 / GISTEMP"
        },
        {
          "id": "mauna_loa_co2",
          "label": "Atmospheric CO2",
          "unit": "ppm",
          "source": "NOAA GML / OCO-3"
        },
        {
          "id": "enso_nino34",
          "label": "ENSO Nino 3.4 Index",
          "unit": "degC",
          "source": "NOAA CPC"
        },
        {
          "id": "global_sst_anomaly",
          "label": "Global SST Anomaly (60S-60N)",
          "unit": "degC",
          "source": "NOAA OISST v2.1"
        }
      ]
    },
    "leftSidebar": {
      "id": "layer_tree_controller",
      "collapsible": true,
      "features": [
        "multi_layer_blending_opacity",
        "altitude_depth_slider",
        "colormap_palette_selector",
        "anomaly_vs_absolute_mode_toggle",
        "raw_data_source_citation_popover"
      ]
    },
    "rightDrawer": {
      "id": "telemetry_analytics_dock",
      "collapsible": true,
      "panels": [
        "point_vertical_profile_sounding_skew_t",
        "ocean_water_column_ctd_profile",
        "regional_time_series_chart",
        "cmip6_ensemble_spread_boxplot",
        "netcdf_zarr_subset_exporter"
      ]
    },
    "bottomDock": {
      "id": "temporal_dimension_controller",
      "rangeStart": "1950-01-01T00:00:00Z",
      "rangeEnd": "2100-12-31T23:59:59Z",
      "modes": [
        {
          "id": "realtime_telemetry",
          "label": "Live Telemetry & Nowcast (-7d to +10d)",
          "step": "10m"
        },
        {
          "id": "historical_reanalysis",
          "label": "Historical Reanalysis (1950-Present)",
          "step": "1d"
        },
        {
          "id": "cmip_projections",
          "label": "CMIP6/CMIP7 Projections (2026-2100)",
          "step": "1M",
          "scenarios": [
            "SSP1-1.9",
            "SSP1-2.6",
            "SSP2-4.5",
            "SSP3-7.0",
            "SSP5-8.5"
          ]
        }
      ]
    }
  },
